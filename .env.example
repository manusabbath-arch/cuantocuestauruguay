# ==========================================
# DATABASE (Auto-configured by Render)
# ==========================================
# In Render: Automatically set from PostgreSQL database connection
# Locally: Use postgres:postgres@localhost:5432/preciosregulados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/preciosregulados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=preciosregulados

# ==========================================
# API CONFIGURATION
# ==========================================
API_V1_PREFIX=/api/v1
PROJECT_NAME=PreciosRegulados.uy

# Debug: Set to False in production
DEBUG=False

# CORS: Add your frontend URL here
# Local: http://localhost:3000,http://localhost:5173
# Production: https://cuantocuestauruguay.com,https://www.cuantocuestauruguay.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://cuantocuestauruguay.com,https://www.cuantocuestauruguay.com

# ==========================================
# EXTERNAL DATA SOURCES (CKAN)
# ==========================================
CKAN_API_URL=https://catalogodatos.gub.uy/api/3/action
CKAN_COMBUSTIBLES_RESOURCE_ID=62bacbab-9bae-4316-af56-7c1bf468f546
CKAN_IPC_RESOURCE_URL=https://catalogodatos.gub.uy/dataset/126e6604-eb45-4376-90fd-a6c5f77d9a1f/resource/50995d42-9475-47df-9d92-d302180efd8c/download/10449_indice_de_precios_al_consumo_-ipc-.csv
BCU_COTIZACIONES_URL=https://www.bcu.gub.uy/Estadisticas-e-Indicadores/Paginas/Cotizaciones.aspx
BCU_DOLAR_ROW_FILTER=DLS. USA
# MEF - Gasto Público (CSV CKAN MEF, ejecución presupuestal por inciso)
CKAN_MEF_EJECUCION_URL=https://catalogodatos.gub.uy/dataset/8e3b2b01-e02d-4f30-9ad3-4aeef11e3a46/resource/fb3ad73f-de49-4b86-91b9-5e88c5e04fd5/download/ejecucion_presupuestal_inciso.csv

# ==========================================
# SCHEDULER (ETL)
# ==========================================
# Time (UTC) to run daily ETL
ETL_SCHEDULE_HOUR=2
ETL_SCHEDULE_MINUTE=0
# Day of week for utilities ETL (mon,tue,wed,thu,fri,sat,sun)
ETL_UTILITIES_DAY_OF_WEEK=mon

# ==========================================
# MONITORING (Optional)
# ==========================================
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=

# ==========================================
# ETL ALERTING (Optional)
# ==========================================
ALERT_EMAIL_ENABLED=False
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True

# ==========================================
# FRONTEND URLs
# ==========================================
# Local development
FRONTEND_URL=http://localhost:3000
# Production domain
PRODUCTION_URL=https://cuantocuestauruguay.com
