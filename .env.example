# ==========================================
# DATABASE (Auto-configured by Render)
# ==========================================
# In Render: Automatically set from PostgreSQL database connection
# Locally: Use postgres:postgres@localhost:5432/preciosregulados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/preciosregulados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=preciosregulados

# ==========================================
# API CONFIGURATION
# ==========================================
API_V1_PREFIX=/api/v1
PROJECT_NAME=PreciosRegulados.uy

# Debug: Set to False in production
DEBUG=False

# CORS: Add your frontend URL here
# Local: http://localhost:3000,http://localhost:5173
# Production: https://cuantocuestauruguay.com,https://www.cuantocuestauruguay.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://cuantocuestauruguay.com,https://www.cuantocuestauruguay.com

# ==========================================
# EXTERNAL DATA SOURCES (CKAN)
# ==========================================
CKAN_API_URL=https://catalogodatos.gub.uy/api/3/action
CKAN_COMBUSTIBLES_RESOURCE_ID=62bacbab-9bae-4316-af56-7c1bf468f546

# ==========================================
# SCHEDULER (ETL)
# ==========================================
# Time (UTC) to run daily ETL
ETL_SCHEDULE_HOUR=2
ETL_SCHEDULE_MINUTE=0

# ==========================================
# MONITORING (Optional)
# ==========================================
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=

# ==========================================
# FRONTEND URLs
# ==========================================
# Local development
FRONTEND_URL=http://localhost:3000
# Production domain
PRODUCTION_URL=https://cuantocuestauruguay.com
